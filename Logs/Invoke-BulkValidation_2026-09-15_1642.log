PS C:\nmg-identity-automation> #=============================================================
#  THROWAWAY ACCOUNTS FOR DAY 14
#  TotalThreat 30-Day Challenge
#
#  Creates 11 test accounts in a Test Accounts OU, and the
#  approved list that points at them.
#
#  These exist so you can break your script on purpose without
#  going anywhere near Sandra's approved list. You will delete
#  them at the end of the day.
#
#  Safe to run as many times as you like.
#=============================================================

Import-Module ActiveDirectory

$Domain = Get-ADDomain
if ($Domain.DNSRoot -ne "NMG.com") {
    Write-Host ""
    Write-Host "  STOP. This is not the NMG.com lab domain." -ForegroundColor Red
    Write-Host ""
    return
}

$Root   = $Domain.DistinguishedName
$OuName = "Test Accounts"
$OuPath = "OU=$OuName,$Root"
$Pw     = ConvertTo-SecureString "Northstar2025!" -AsPlainText -Force

Write-Host ""
Write-Host "  THROWAWAY ACCOUNTS FOR DAY 14" -ForegroundColor Cyan
Write-Host "  -----------------------------"
Write-Host ""

#--- The OU they live in -------------------------------------
# Separate from everything else, so you can see at a glance
# that today never touched a real account.

if (-not (Get-ADOrganizationalUnit -Filter "Name -eq '$OuName'" -ErrorAction SilentlyContinue)) {
    New-ADOrganizationalUnit -Name $OuName -Path $Root `
        -ProtectedFromAccidentalDeletion $false
    Write-Host "        created OU : $OuName" -ForegroundColor Green
}

#--- A group for them to belong to ---------------------------
# The rollback has to put memberships back, so they need some.

foreach ($g in @("Test-Users", "Test-Shared")) {
    if (-not (Get-ADGroup -Filter "Name -eq '$g'" -ErrorAction SilentlyContinue)) {
        New-ADGroup -Name $g -GroupScope Global -GroupCategory Security `
            -Path $OuPath -Description "Day 14 throwaway group"
        Write-Host "        created group : $g" -ForegroundColor Green
    }
}

#--- The 11 accounts -----------------------------------------

$made = 0; $already = 0

foreach ($i in 1..11) {

    $sam  = "testuser{0:D2}" -f $i
    $name = "Test User {0:D2}" -f $i

    if (Get-ADUser -Filter "SamAccountName -eq '$sam'" -ErrorAction SilentlyContinue) {
        $already++
        continue
    }

    New-ADUser `
        -Name                  $name `
        -DisplayName           $name `
        -SamAccountName        $sam `
        -UserPrincipalName     "$sam@NMG.com" `
        -Path                  $OuPath `
        -Department            "Test Accounts" `
        -Title                 "Throwaway" `
        -AccountPassword       $Pw `
        -Enabled               $true `
        -ChangePasswordAtLogon $false

    Add-ADGroupMember -Identity "Test-Users"  -Members $sam
    Add-ADGroupMember -Identity "Test-Shared" -Members $sam

    Write-Host "        created : $sam" -ForegroundColor Green
    $made++
}

#--- The approved list that points at them -------------------
# Same shape as Sandra's Approved.csv, so your bulk script
# does not need to know the difference.

$Folder = "C:\Reports\Separations"
if (-not (Test-Path $Folder)) {
    New-Item -Path $Folder -ItemType Directory -Force | Out-Null
}

$File = "$Folder\test-accounts.csv"

1..11 | ForEach-Object {
    [PSCustomObject]@{
        Row      = $_ + 1
        Username = "testuser{0:D2}" -f $_
        Name     = "Test User {0:D2}" -f $_
        LastSeen = (Get-Date).AddDays(-200)
        Verdict  = "READY"
    }
} | Export-Csv $File -NoTypeInformation

Write-Host ""
Write-Host "        Created  : $made"
Write-Host "        Already there : $already"
Write-Host "        List     : $File"
Write-Host ""
Write-Host "  11 throwaway accounts, each in 2 groups." -ForegroundColor DarkGray
Write-Host "  Break anything you like. You delete them at the end" -ForegroundColor DarkGray
Write-Host "  of the day, and Sandra's list is never touched." -ForegroundColor DarkGray
Write-Host ""

  THROWAWAY ACCOUNTS FOR DAY 14
  -----------------------------

        created OU : Test Accounts
        created group : Test-Users
        created group : Test-Shared
        created : testuser01
        created : testuser02
        created : testuser03
        created : testuser04
        created : testuser05
        created : testuser06
        created : testuser07
        created : testuser08
        created : testuser09
        created : testuser10
        created : testuser11

        Created  : 11
        Already there : 0
        List     : C:\Reports\Separations\test-accounts.csv

