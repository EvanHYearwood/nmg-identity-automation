PS C:\Scripts> #=============================================================
#  DAY 14 RESET
#
#  Puts the lab back to where it was before Day 14 started.
#  Run this, then start Day 14 again from the top tomorrow.
#
#  It removes:
#    1. The 11 throwaway accounts and their OU and groups
#    2. Today's evidence files, logs and result files
#    3. The test-accounts.csv list
#    4. The Day 14 script from C:\Scripts
#
#  It does NOT touch:
#    - Sandra's 22 approved accounts
#    - Anything in the repository except what today created
#    - Approved.csv, Validation-Report.txt or the dropped file
#    - Rachel's approval file, if you made one
#
#  Everything it finds is listed before anything is deleted,
#  and it asks once before doing it.
#=============================================================

Import-Module ActiveDirectory

$Domain = Get-ADDomain
if ($Domain.DNSRoot -ne "NMG.com") {
    Write-Host ""
    Write-Host "  STOP. This is not the NMG.com lab domain." -ForegroundColor Red
    Write-Host ""
    return
}

$Root  = $Domain.DistinguishedName
$Today = Get-Date -Format "yyyy-MM-dd"

Write-Host ""
Write-Host "  DAY 14 RESET" -ForegroundColor Cyan
Write-Host "  ------------"
Write-Host ""

#--- 1. WHAT ACCOUNTS EXIST FROM TODAY -----------------------

Write-Host "  [1/4] Throwaway accounts" -ForegroundColor Yellow

$testUsers = Get-ADUser -Filter "SamAccountName -like 'testuser*'" `
    -Properties MemberOf, Description, Enabled

if ($testUsers) {
    $testUsers | ForEach-Object {
        $where = if ($_.DistinguishedName -like "*Disabled Users*") { "quarantine" }
                 elseif ($_.DistinguishedName -like "*Test Accounts*") { "test OU" }
                 else { "elsewhere" }
        Write-Host ("        {0,-12} enabled={1,-5} groups={2,-2} in {3}" -f
            $_.SamAccountName, $_.Enabled, $_.MemberOf.Count, $where)
    }
} else {
    Write-Host "        none found" -ForegroundColor DarkGray
}

$testOU     = Get-ADOrganizationalUnit -Filter "Name -eq 'Test Accounts'" -ErrorAction SilentlyContinue
$testGroups = Get-ADGroup -Filter "Name -like 'Test-*'" -ErrorAction SilentlyContinue

if ($testOU)     { Write-Host "        OU     : Test Accounts" }
if ($testGroups) { $testGroups | ForEach-Object { Write-Host "        group  : $($_.Name)" } }

#--- 2. SANDRA'S 22 ARE UNTOUCHED ----------------------------

Write-Host ""
Write-Host "  [2/4] Sandra's approved accounts" -ForegroundColor Yellow

$approvedFile = "C:\Reports\Separations\Approved.csv"
$touched = @()

if (Test-Path $approvedFile) {
    Import-Csv $approvedFile | ForEach-Object {
        $u = Get-ADUser -Identity $_.Username -Properties Description -ErrorAction SilentlyContinue
        if ($u -and ($u.Enabled -eq $false -or $u.Description -like "*NMG-0215*")) {
            $touched += $u.SamAccountName
        }
    }
    if ($touched) {
        Write-Host "        WARNING: these approved accounts were modified today:" -ForegroundColor Red
        $touched | ForEach-Object { Write-Host "          $_" -ForegroundColor Red }
        Write-Host "        This script will not touch them. Fix by hand." -ForegroundColor Red
    } else {
        Write-Host "        all 22 untouched. Good." -ForegroundColor Green
    }
} else {
    Write-Host "        Approved.csv not found, skipping check" -ForegroundColor DarkGray
}

#--- 3. FILES FROM TODAY -------------------------------------

Write-Host ""
Write-Host "  [3/4] Files created today" -ForegroundColor Yellow

$files = @()
$files += Get-ChildItem "C:\Reports\Offboarding\testuser*"           -ErrorAction SilentlyContinue
$files += Get-ChildItem "C:\Reports\Offboarding\BulkRun_*"           -ErrorAction SilentlyContinue
$files += Get-ChildItem "C:\Reports\Separations\test-accounts.csv"   -ErrorAction SilentlyContinue
$files += Get-ChildItem "C:\Scripts\Invoke-BulkOffboarding.ps1"      -ErrorAction SilentlyContinue
$files += Get-ChildItem "C:\nmg-identity-automation\Logs\Invoke-BulkOffboarding_*" -ErrorAction SilentlyContinue
$files += Get-ChildItem "C:\nmg-identity-automation\Scripts\Invoke-BulkOffboarding.ps1" -ErrorAction SilentlyContinue
$files += Get-ChildItem "C:\nmg-identity-automation\Evidence\testuser*" -ErrorAction SilentlyContinue
$files += Get-ChildItem "C:\nmg-identity-automation\Evidence\BulkRun_*" -ErrorAction SilentlyContinue

if ($files) {
    $files | ForEach-Object { Write-Host "        $($_.FullName)" }
} else {
    Write-Host "        none found" -ForegroundColor DarkGray
}

#--- 4. CONFIRM, THEN DELETE ---------------------------------

Write-Host ""
Write-Host "  [4/4] Ready to remove everything listed above." -ForegroundColor Yellow
Write-Host ""
$answer = Read-Host "        Type RESET to continue, anything else to stop"

if ($answer -ne "RESET") {
    Write-Host ""
    Write-Host "  Nothing changed." -ForegroundColor DarkGray
    Write-Host ""
    return
}

Write-Host ""

# accounts first, then groups, then the OU
$testUsers | ForEach-Object {
    Remove-ADUser -Identity $_ -Confirm:$false
    Write-Host "        removed : $($_.SamAccountName)" -ForegroundColor Green
}
$testGroups | ForEach-Object {
    Remove-ADGroup -Identity $_ -Confirm:$false
    Write-Host "        removed : $($_.Name)" -ForegroundColor Green
}
if ($testOU) {
    Set-ADOrganizationalUnit -Identity $testOU -ProtectedFromAccidentalDeletion $false
    Remove-ADOrganizationalUnit -Identity $testOU -Confirm:$false -Recursive
    Write-Host "        removed : OU Test Accounts" -ForegroundColor Green
}

# files
$files | ForEach-Object {
    Remove-Item $_.FullName -Force
    Write-Host "        removed : $($_.Name)" -ForegroundColor Green
}

#--- 5. THE REPOSITORY ---------------------------------------

Write-Host ""
Write-Host "  Repository state:" -ForegroundColor Yellow

Push-Location "C:\nmg-identity-automation"
$status = git status --porcelain 2>$null
if ($status) {
    Write-Host "        uncommitted changes exist:"
    $status | ForEach-Object { Write-Host "          $_" }
    Write-Host ""
    Write-Host "        If any of these are from Day 14, discard them:" -ForegroundColor DarkGray
    Write-Host "          git checkout -- <file>     for a modified file" -ForegroundColor DarkGray
    Write-Host "          Remove-Item <file>         for a new file" -ForegroundColor DarkGray
} else {
    Write-Host "        clean. Nothing from today was committed." -ForegroundColor Green
}
Pop-Location

Write-Host ""
Write-Host "  Done. Lab is back to the end of Day 13." -ForegroundColor Cyan
Write-Host ""

